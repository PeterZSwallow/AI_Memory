# PostgreSQL connection string
DATABASE_URL=postgres://vitrina:vitrina@localhost:5432/vitrina

# Claude API key for AI features. Without it the app falls back to
# deterministic heuristics so the demo never breaks.
ANTHROPIC_API_KEY=

# Photo storage. If S3_BUCKET is set, uploads go to S3 / Cloudflare R2 / MinIO,
# otherwise they are written to UPLOAD_DIR on local disk.
UPLOAD_DIR=./uploads
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Used to show approximate USD prices in the English UI
USD_RUB_RATE=92
